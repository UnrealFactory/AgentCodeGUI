{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentCodeGUI3",
  "mainBinaryName": "AgentCodeGUI3",
  "version": "3.0.0-beta.1",
  "identifier": "com.agentcodegui.app",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run app:dev",
    "beforeBuildCommand": "npm run app:build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon3.ico"],
    "publisher": "AgentCodeGUI",
    "homepage": "https://github.com/UnrealFactory/AgentCodeGUI",
    "copyright": "Copyright (c) 2026 AgentCodeGUI",
    "category": "DeveloperTool",
    "shortDescription": "AgentCodeGUI 3.0 — Claude Code 데스크탑 IDE",
    "longDescription": "AgentCodeGUI 3.0 — Claude Code 데스크탑 IDE (자체 파일 탐색기 + LSP 코드 인텔리전스). Tauri + Rust 재구축본.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../build/icon3.ico",
        "headerImage": "../build/installerHeader.bmp",
        "sidebarImage": "../build/installerSidebar.bmp",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  }
}
