{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@renderer/*": ["./src/*"]
    }
  },
  // 이식본 전체 + 계약면(단일 소스). 심(shim.ts)이 WindowApi를 **전부** 구현하는지는
  // 여기서만 검사된다 — vite build는 타입을 보지 않는다.
  "include": ["src/**/*", "../src/shared/**/*"]
}
